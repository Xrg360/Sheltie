{
  "name": "sheltie",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8710",
    "dev:demo": "NEXT_PUBLIC_SHELTIE_DEMO=1 next dev -p 8710",
    "build": "next build",
    "build:demo": "SHELTIE_STATIC_EXPORT=1 SHELTIE_BASE_PATH=${SHELTIE_BASE_PATH-/demo} next build",
    "start": "next start -p 8710",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
